      "moduleId": "scheduling",
      "name": "Scheduling",
      "version": "0.1.0",
      "category": "clinical-operations",
      "description": "Appointment booking, provider availability, queues, reminders, and encounter linking.",
      "repositoryUrl": "../shin-scheduling",
      "minPlatformVersion": "0.1.0",
      "dependencies": [],
      "permissions": ["scheduling.read", "scheduling.write", "scheduling.admin"],
      "routes": [{ "path": "/modules/scheduling", "label": "Scheduling" }],
      "events": {
        "publishes": ["scheduling.appointment.created", "scheduling.appointment.updated"],
        "subscribes": ["patient.record.created", "practitioner.created"]
      },
      "dashboard": {
        "cards": [
          { "label": "Scheduling Queue", "value": "57", "detail": "Appointments today", "tone": "default", "href": "/modules/scheduling" }
        ],
        "sections": [
          {
            "title": "Scheduling Flow",
            "description": "Appointment demand, provider availability, and queue pressure.",
            "href": "/modules/scheduling",
            "widgets": [
              { "label": "Today's Appointments", "value": "57", "detail": "11 pending check-in", "tone": "default", "href": "/modules/scheduling" },
              { "label": "Waitlist", "value": "14", "detail": "3 high-priority slots", "tone": "warning", "href": "/modules/scheduling" },
              { "label": "Reminders", "value": "92%", "detail": "Delivery success rate", "tone": "success", "href": "/modules/scheduling" }
            ]
          }
        ],
        "alerts": [
          { "severity": "warning", "title": "Provider availability gaps", "body": "Three appointment types need updated availability windows.", "href": "/modules/scheduling" }
        ],
        "quickActions": [
          { "label": "Open scheduling", "href": "/modules/scheduling" }
        ]
      },
      "setupChecklist": ["Configure appointment types", "Configure provider availability", "Configure reminder rules"]
    },
