{
  "name": "shin",
  "version": "0.1.0",
  "private": true,
  "description": "SHIN Node shell for installing and managing modular InteropMed healthcare apps",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "frontend:dev": "set NODE_OPTIONS=--max-old-space-size=4096&& npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:start": "npm --prefix frontend run start",
    "backend:dev": "py -3 backend/manage.py runserver 127.0.0.1:8000",
    "backend:check": "py -3 backend/manage.py check",
    "test": "vitest run frontend"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
